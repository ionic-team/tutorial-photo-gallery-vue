{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "description": "Renovate may only open or update PRs on Mondays, 6-10am ET.",
  "timezone": "America/New_York",
  "minimumReleaseAge": "3 days",
  "schedule": ["* 6-10 * * 1"],
  "semanticCommits": "enabled",
  "ignorePaths": ["android/**", "ios/**"],
  "gitIgnoredAuthors": ["hi@ionicframework.com"],
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["@ionic/**", "!@ionic/eslint-config", "!@ionic/prettier-config"],
      "minimumReleaseAge": "0 days",
      "groupName": "ionic"
    },
    {
      "matchPackageNames": ["vue"],
      "groupName": "vue"
    },
    {
      "matchPackageNames": ["vue-router"],
      "groupName": "vue-router"
    },
    {
      "matchPackageNames": ["@capacitor/**"],
      "groupName": "capacitor"
    },
    {
      "matchPackageNames": ["vite", "@vitejs/**"],
      "groupName": "vite"
    },
    {
      "matchPackageNames": [
        "vitest*",
        "@playwright/test",
        "@vue/test-utils",
        "jsdom"
      ],
      "groupName": "testing"
    },
    {
      "matchPackageNames": [
        "eslint",
        "eslint-plugin-*",
        "@eslint/**",
        "@ionic/eslint-config",
        "globals",
        "@vue/eslint-config-typescript"
      ],
      "groupName": "linting"
    },
    {
      "matchPackageNames": [
        "typescript",
        "vue-tsc",
        "prettier",
        "@ionic/prettier-config"
      ],
      "groupName": "dev-tools"
    },
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25",
      "description": "Keep Node's types on the major version CI runs (24)"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.0.0",
      "description": "Stay on the starter's TypeScript 5.x. typescript-eslint and vue-tsc don't support TypeScript 7 yet."
    },
    {
      "description": "Automerge minor and patch updates once CI passes. Majors and 0.x packages, where a minor can break, still need review.",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "CI only tests the web build, so Capacitor updates still need review for native changes. Pinned so lockfile maintenance can't update it either.",
      "matchPackageNames": ["@capacitor/**"],
      "rangeStrategy": "pin",
      "automerge": false
    }
  ]
}
